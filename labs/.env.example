# ---------------------------------------------------------------------------
# labs/.env.example  —  copy to labs/.env and edit if you like.
#
#   cp labs/.env.example labs/.env
#
# labs/.env is gitignored. These are LOCAL-ONLY DEV defaults: the whole stack
# binds to 127.0.0.1 only (see compose.yaml), so nothing here is reachable off
# your machine. Do NOT reuse these values anywhere real.
# ---------------------------------------------------------------------------

# --- Object store (S3-compatible, MinIO-compatible fork "silo") -------------
# These are read by silo as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD and are the
# S3 access key / secret used by every other service.
AWS_ACCESS_KEY_ID=lab-admin
AWS_SECRET_ACCESS_KEY=lab-admin-secret-change-me
AWS_REGION=us-east-1

# Bucket that holds the Iceberg warehouse. Created by the one-shot `mc` job.
WAREHOUSE_BUCKET=warehouse

# --- Host port bindings (all bound to 127.0.0.1 in compose.yaml) ------------
# Change the left-hand side only if a port is already taken on your host.
S3_API_PORT=9000           # silo S3 API
S3_CONSOLE_PORT=9001       # silo web console
ICEBERG_REST_PORT=8181     # Iceberg REST catalog
SPARK_CONNECT_PORT=15002   # Spark Connect gRPC (host PySpark connects here)
SPARK_UI_PORT=4040         # Spark driver UI
JUPYTER_PORT=8889          # JupyterLab
TRINO_PORT=8080            # Trino HTTP / JDBC

# --- Streaming profile (Phase 3; all 127.0.0.1, deliberately NON-standard) --
# NEVER use 5432 (user's local_pgdb) or 8888 (user's pgadmin) here.
LAB_KAFKA_PORT=19092       # Kafka EXTERNAL listener (host)
LAB_SR_PORT=8081           # Schema Registry
LAB_CONNECT_PORT=8083      # Kafka Connect REST
LAB_PG_PORT=5433           # CDC Postgres (NOT 5432)
LAB_UI_PORT=8085           # Kafka UI
LAB_PG_USER=cdc
LAB_PG_PASSWORD=cdc
LAB_PG_DB=cdc

# --- Flink profile (Phase 4; all 127.0.0.1, deliberately NON-standard) ------
# NEVER use 5432 (user's local_pgdb) or 8888 (user's pgadmin) here.
LAB_FLINK_REST_PORT=8086   # Flink JobManager REST / web UI
LAB_FLINK_SQL_GW_PORT=8087 # Flink SQL Gateway REST

# --- Jupyter ----------------------------------------------------------------
# Empty token = no password prompt (local only). Set a value to require one.
JUPYTER_TOKEN=
